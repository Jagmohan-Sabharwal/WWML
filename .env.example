# Local development only. Copy to .env; never commit real credentials.
POSTGRES_DB=wwml
POSTGRES_USER=wwml
POSTGRES_PASSWORD=wwml_local_dev_only
BACKEND_PORT=8000
FRONTEND_PORT=3000


APP_NAME=WWML API
LOG_LEVEL=INFO

# Optional Google Drive metadata reader; blank leaves it disabled.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_MAX_FILES=10000
GOOGLE_DRIVE_MAX_FOLDERS=1000
GOOGLE_DRIVE_MAX_REQUESTS=1000
GOOGLE_DRIVE_REQUEST_TIMEOUT_SECONDS=10
GOOGLE_DRIVE_SCAN_TIMEOUT_SECONDS=60
# For docker-compose.drive.yml, set an absolute host path outside this repository.
# GOOGLE_DRIVE_CREDENTIALS_FILE=/absolute/path/to/google-credentials.json

# Optional Google Drive importer (docker-compose.import.yml)
# Imported copies only; originals are never renamed.
IMPORT_POLL_SECONDS=60
IMPORT_MAX_BYTES=10737418240
IMPORT_MAX_ATTEMPTS=3
IMPORT_DOWNLOAD_TIMEOUT_SECONDS=1800
